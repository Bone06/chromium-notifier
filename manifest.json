{
  "author": "Christian Mund <opensource@mundpropaganda.net>",
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon_16.png",
      "24": "img/icon_24.png",
      "32": "img/icon_32.png",
      "48": "img/icon_48.png",
      "64": "img/icon_64.png",
      "128": "img/icon_128.png",
      "256": "img/icon_256.png"
    }
  },
  "description": "Chromium browser and extension update notifications with signed multi-source build data and extension management.",
  "icons": {
    "16": "img/icon_16.png",
    "24": "img/icon_24.png",
    "32": "img/icon_32.png",
    "48": "img/icon_48.png",
    "64": "img/icon_64.png",
    "128": "img/icon_128.png",
    "256": "img/icon_256.png"
  },
  "homepage_url": "https://github.com/kkkrist/chromium-notifier",
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "name": "Chromium Update Notifications",
  "permissions": ["alarms", "management", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "update_url": "https://raw.githubusercontent.com/kkkrist/chromium-notifier/master/gupdate.xml",
  "version": "4.0.0",
  "version_name": "4.0.0"
}
